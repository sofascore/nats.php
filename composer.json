{
    "name": "sofascore/nats.php",
    "description": "Modern PHP 8.5 client for NATS messaging system with JetStream, KeyValue, ObjectStore, and Micro service support",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nats",
        "nats.php",
        "jetstream",
        "messaging",
        "pubsub",
        "keyvalue",
        "objectstore",
        "microservices",
        "php85"
    ],
    "homepage": "https://github.com/sofascore/nats.php",
    "authors": [
        {
            "name": "Sofascore",
            "email": "backend-team@sofascore.com"
        }
    ],
    "support": {
        "issues": "https://github.com/sofascore/nats.php/issues",
        "source": "https://github.com/sofascore/nats.php"
    },
    "require": {
        "php": ">=8.5",
        "ext-sodium": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "psr/log": "For PSR-3 logging support"
    },
    "autoload": {
        "psr-4": {
            "Sofascore\\Nats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sofascore\\Nats\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
