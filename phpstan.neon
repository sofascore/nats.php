parameters:
    level: max
    paths:
        - src
    ignoreErrors:
        # ConsumeContext::run() — PHPStan sees $stopped as false because the while(!$this->stopped)
        # loop just passed. But the handler callback on line 67 can call $ctx->stop() which mutates
        # $this->stopped mid-iteration. Same for the error handler on line 79.
        -
            identifier: if.alwaysFalse
            count: 1
            path: src/JetStream/Consumer/ConsumeContext.php
        -
            identifier: booleanOr.rightAlwaysFalse
            count: 1
            path: src/JetStream/Consumer/ConsumeContext.php
